{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json",
  "autosize": {
    "contains": "padding",
    "type": "fit-x"
  },
  "config": {
    "view": {
      "continuousHeight": 300,
      "continuousWidth": 300
    }
  },
  "data": {
    "format": {
      "parse": {
        "moved_mwh": "number",
        "share_of_moved_pct": "number"
      },
      "type": "csv"
    },
    "url": "results/q2_moved_energy_by_unit_type.csv"
  },
  "description": "Where the 221 GWh that moved came from",
  "height": 132,
  "layer": [
    {
      "encoding": {
        "tooltip": [
          {
            "field": "unit_type",
            "title": "Unit type",
            "type": "nominal"
          },
          {
            "field": "moved_mwh",
            "format": ",.0f",
            "title": "Moved, MWh",
            "type": "quantitative"
          },
          {
            "field": "share_of_moved_pct",
            "format": ".1f",
            "title": "Share, %",
            "type": "quantitative"
          }
        ],
        "x": {
          "axis": {
            "title": [
              "Share of the energy moved, %"
            ],
            "values": [
              0,
              25,
              50,
              75,
              100
            ]
          },
          "field": "share_of_moved_pct",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "type": "quantitative"
        },
        "y": {
          "axis": {
            "labelExpr": "split(datum.label, '|')"
          },
          "field": "label",
          "scale": {
            "paddingInner": 0.3
          },
          "sort": null,
          "title": null,
          "type": "nominal"
        }
      },
      "mark": {
        "color": "#2a78d6",
        "cornerRadiusEnd": 3,
        "type": "bar"
      }
    },
    {
      "encoding": {
        "text": {
          "field": "share_label",
          "type": "nominal"
        },
        "x": {
          "axis": {
            "title": [
              "Share of the energy moved, %"
            ],
            "values": [
              0,
              25,
              50,
              75,
              100
            ]
          },
          "field": "share_of_moved_pct",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "type": "quantitative"
        },
        "y": {
          "axis": {
            "labelExpr": "split(datum.label, '|')"
          },
          "field": "label",
          "scale": {
            "paddingInner": 0.3
          },
          "sort": null,
          "title": null,
          "type": "nominal"
        }
      },
      "mark": {
        "align": "left",
        "dx": 4,
        "type": "text"
      }
    }
  ],
  "title": {
    "anchor": "start",
    "text": {
      "expr": "containerSize()[0] + 0 * width < 700 ? [\"Where the 221 GWh that moved came from\"] : [\"Where the 221 GWh that moved came from\"]"
    }
  },
  "transform": [
    {
      "as": "share_label",
      "calculate": "format(datum.share_of_moved_pct, '.0f') + '%'"
    }
  ],
  "width": "container"
}
