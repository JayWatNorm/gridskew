{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json",
  "config": {
    "view": {
      "continuousHeight": 300,
      "continuousWidth": 300
    }
  },
  "data": {
    "format": {
      "parse": {
        "section": "number",
        "so_flagged_level_energy_pct": "number",
        "so_flagged_volume_pct": "number"
      },
      "type": "csv"
    },
    "url": "results/q24_system_action_share.csv"
  },
  "encoding": {
    "color": {
      "field": "measure",
      "legend": {
        "labelExpr": "datum.label == \"so_flagged_volume_pct\" ? \"acceptance volume\" : datum.label == \"so_flagged_level_energy_pct\" ? \"level energy\" : datum.label",
        "orient": "bottom",
        "title": null
      },
      "scale": {
        "domain": [
          "so_flagged_volume_pct",
          "so_flagged_level_energy_pct"
        ],
        "range": [
          "#4c72b0",
          "#dd8452"
        ]
      },
      "sort": [
        "so_flagged_volume_pct",
        "so_flagged_level_energy_pct"
      ],
      "type": "nominal"
    },
    "tooltip": [
      {
        "field": "fuel_group",
        "type": "nominal"
      },
      {
        "field": "acceptances",
        "type": "nominal"
      },
      {
        "field": "stretches",
        "type": "nominal"
      },
      {
        "field": "acceptance_volume_mwh",
        "type": "nominal"
      },
      {
        "field": "measure",
        "type": "nominal"
      },
      {
        "field": "value",
        "type": "quantitative"
      }
    ],
    "x": {
      "field": "value",
      "title": "Flagged as a system action, %",
      "type": "quantitative"
    },
    "y": {
      "field": "fuel_group",
      "sort": null,
      "title": null,
      "type": "nominal"
    },
    "yOffset": {
      "field": "measure",
      "sort": [
        "so_flagged_volume_pct",
        "so_flagged_level_energy_pct"
      ],
      "type": "nominal"
    }
  },
  "mark": {
    "type": "bar"
  },
  "title": {
    "anchor": "start",
    "subtitle": [
      "Share of acceptance volume, with the level-energy share",
      "beside it; all months",
      "Months 2025-08 to 2026-09; cutoff 2026-09-30 22:30 UTC;",
      "acceptances and stretches per group in the CSV"
    ],
    "text": [
      "Q24. Share flagged as a system action, by",
      "fuel group"
    ]
  },
  "transform": [
    {
      "filter": {
        "equal": 2,
        "field": "section"
      }
    },
    {
      "as": [
        "measure",
        "value"
      ],
      "fold": [
        "so_flagged_volume_pct",
        "so_flagged_level_energy_pct"
      ]
    }
  ],
  "width": "container"
}
