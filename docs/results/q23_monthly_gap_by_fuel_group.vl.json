  "title": {
    "anchor": "start",
    "subtitle": {
      "signal": "containerSize()[0] + 0 * width < 400 ? [\"Each line is a fuel group's typical gap between plan\", \"and meter, month by month, in half-hours with no\", \"instruction. Higher is further from plan; the dashed\", \"end is September 2026, on early meter data.\"] : (containerSize()[0] + 0 * width < 480 ? [\"Each line is a fuel group's typical gap between plan and meter,\", \"month by month, in half-hours with no instruction. Higher is\", \"further from plan; the dashed end is September 2026, on early\", \"meter data.\"] : (containerSize()[0] + 0 * width < 560 ? [\"Each line is a fuel group's typical gap between plan and meter, month by month,\", \"in half-hours with no instruction. Higher is further from plan; the dashed end\", \"is September 2026, on early meter data.\"] : (containerSize()[0] + 0 * width < 640 ? [\"Each line is a fuel group's typical gap between plan and meter, month by month, in half-hours\", \"with no instruction. Higher is further from plan; the dashed end is September 2026, on early\", \"meter data.\"] : (containerSize()[0] + 0 * width < 720 ? [\"Each line is a fuel group's typical gap between plan and meter, month by month, in half-hours with no\", \"instruction. Higher is further from plan; the dashed end is September 2026, on early meter data.\"] : ([\"Each line is a fuel group's typical gap between plan and meter, month by month, in half-hours with no instruction. Higher\", \"is further from plan; the dashed end is September 2026, on early meter data.\"])))))"
    },
    "text": {
      "expr": "containerSize()[0] + 0 * width < 400 ? [\"The typical wind farm missed its plan by 6.3 to\", \"8.0% of its capacity in every whole month; every\", \"other type, by under 3.5%\"] : (containerSize()[0] + 0 * width < 480 ? [\"The typical wind farm missed its plan by 6.3 to 8.0% of\", \"its capacity in every whole month; every other type, by\", \"under 3.5%\"] : (containerSize()[0] + 0 * width < 560 ? [\"The typical wind farm missed its plan by 6.3 to 8.0% of its capacity\", \"in every whole month; every other type, by under 3.5%\"] : (containerSize()[0] + 0 * width < 640 ? [\"The typical wind farm missed its plan by 6.3 to 8.0% of its capacity in every\", \"whole month; every other type, by under 3.5%\"] : (containerSize()[0] + 0 * width < 720 ? [\"The typical wind farm missed its plan by 6.3 to 8.0% of its capacity in every whole month;\", \"every other type, by under 3.5%\"] : ([\"The typical wind farm missed its plan by 6.3 to 8.0% of its capacity in every whole month; every other\", \"type, by under 3.5%\"])))))"
    }
  },
  "transform": [
    {
      "as": "fuel_group_name",
      "calculate": "datum.fuel_group == \"\" ? \"All fuel groups\" : datum.fuel_group == \"bioenergy\" ? \"Bioenergy\" : datum.fuel_group == \"coal\" ? \"Coal\" : datum.fuel_group == \"gas_turbine\" ? \"Gas\" : datum.fuel_group == \"hydro\" ? \"Hydro\" : datum.fuel_group == \"interconnector\" ? \"Interconnector\" : datum.fuel_group == \"nuclear\" ? \"Nuclear\" : datum.fuel_group == \"oil\" ? \"Oil\" : datum.fuel_group == \"other\" ? \"Other\" : datum.fuel_group == \"pumped_storage\" ? \"Pumped storage\" : datum.fuel_group == \"unclassified\" ? \"Unclassified\" : datum.fuel_group == \"wind\" ? \"Wind\" : datum.fuel_group"
    }
  ],
  "width": "container"
