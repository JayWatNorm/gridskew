{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json",
  "autosize": {
    "contains": "padding",
    "type": "fit-x"
  },
  "config": {
    "view": {
      "continuousHeight": 300,
      "continuousWidth": 300
    }
  },
  "data": {
    "format": {
      "parse": {
        "share_of_positive_shortfall_pct": "number"
      },
      "type": "csv"
    },
    "url": "results/q5_shortfall_with_known_outage.csv"
  },
  "encoding": {
    "color": {
      "field": "outage_class_name",
      "legend": {
        "columns": 2,
        "orient": "bottom",
        "title": null
      },
      "scale": {
        "domain": [
          "Planned",
          "Unplanned",
          "Both",
          "None"
        ],
        "range": [
          "#2a78d6",
          "#eb6834",
          "#1baf7a",
          "#a3a19a"
        ]
      },
      "sort": [
        "Planned",
        "Unplanned",
        "Both",
        "None"
      ],
      "type": "nominal"
    },
    "order": {
      "field": "stack_order",
      "type": "quantitative"
    },
    "tooltip": [
      {
        "field": "fuel_group_name",
        "title": "Fuel group",
        "type": "nominal"
      },
      {
        "field": "outage_class_name",
        "title": "Outage class",
        "type": "nominal"
      },
      {
        "field": "unit_periods",
        "title": "Unit-periods",
        "type": "nominal"
      },
      {
        "field": "positive_shortfall_mwh",
        "title": "Positive shortfall, MWh",
        "type": "nominal"
      },
      {
        "field": "share_of_positive_shortfall_pct",
        "format": ".1f",
        "title": "Share of positive shortfall, %",
        "type": "quantitative"
      }
    ],
    "x": {
      "axis": {
        "values": [
          0,
          25,
          50,
          75,
          100
        ]
      },
      "field": "share_of_positive_shortfall_pct",
      "scale": {
        "domain": [
          0,
          100
        ]
      },
      "title": "Share of positive unexplained shortfall, %",
      "type": "quantitative"
    },
    "y": {
      "field": "fuel_group_name",
      "scale": {
        "paddingInner": 0.3
      },
      "sort": null,
      "title": null,
      "type": "nominal"
    }
  },
  "height": 280,
  "mark": {
    "type": "bar"
  },
  "title": {
    "anchor": "start",
    "text": {
      "expr": "containerSize()[0] + 0 * width < 700 ? [\"Share of positive unexplained shortfall by\", \"outage class known at the half-hour's start\", \"n=8675654 determinable cohort\", \"unit-periods, 2025-08-22 to 2026-09-27;\", \"cutoff 2026-09-27 22:30 UTC\"] : [\"Share of positive unexplained shortfall by outage class known at the half-hour's start\", \"n=8675654 determinable cohort unit-periods, 2025-08-22 to 2026-09-27; cutoff 2026-09-27 22:30 UTC\"]"
    }
  },
  "transform": [
    {
      "filter": {
        "field": "item",
        "oneOf": [
          "planned",
          "unplanned",
          "both",
          "none"
        ]
      }
    },
    {
      "as": "fuel_group_name",
      "calculate": "datum.fuel_group == \"\" ? \"All fuel groups\" : datum.fuel_group == \"bioenergy\" ? \"Bioenergy\" : datum.fuel_group == \"coal\" ? \"Coal\" : datum.fuel_group == \"gas_turbine\" ? \"Gas turbine\" : datum.fuel_group == \"hydro\" ? \"Hydro\" : datum.fuel_group == \"interconnector\" ? \"Interconnector\" : datum.fuel_group == \"nuclear\" ? \"Nuclear\" : datum.fuel_group == \"oil\" ? \"Oil\" : datum.fuel_group == \"other\" ? \"Other\" : datum.fuel_group == \"pumped_storage\" ? \"Pumped storage\" : datum.fuel_group == \"unclassified\" ? \"Unclassified\" : datum.fuel_group == \"wind\" ? \"Wind\" : datum.fuel_group"
    },
    {
      "as": "outage_class_name",
      "calculate": "datum.item == \"planned\" ? \"Planned\" : datum.item == \"unplanned\" ? \"Unplanned\" : datum.item == \"both\" ? \"Both\" : datum.item == \"none\" ? \"None\" : datum.item"
    },
    {
      "as": "stack_order",
      "calculate": "indexof([\"planned\", \"unplanned\", \"both\", \"none\"], datum.item)"
    }
  ],
  "width": "container"
}
