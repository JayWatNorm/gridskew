{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json",
  "autosize": {
    "contains": "padding",
    "type": "fit-x"
  },
  "config": {
    "view": {
      "continuousHeight": 300,
      "continuousWidth": 300
    }
  },
  "data": {
    "format": {
      "parse": {
        "index": "number",
        "index_high": "number",
        "index_low": "number",
        "mean_shortfall_mwh": "number"
      },
      "type": "csv"
    },
    "url": "results/q28_shortfall_index_by_miss_fifth.csv"
  },
  "description": "Bigger carbon misses came with slightly more shortfall, not 25% more",
  "height": 220,
  "layer": [
    {
      "encoding": {
        "x": {
          "datum": 125,
          "scale": {
            "domain": [
              95,
              130
            ],
            "nice": false
          }
        }
      },
      "mark": {
        "color": "#8c959f",
        "strokeDash": [
          5,
          4
        ],
        "type": "rule"
      },
      "transform": [
        {
          "aggregate": [
            {
              "as": "rows",
              "op": "count"
            }
          ]
        }
      ]
    },
    {
      "encoding": {
        "text": {
          "value": "needed for yes"
        },
        "x": {
          "datum": 125,
          "scale": {
            "domain": [
              95,
              130
            ],
            "nice": false
          }
        },
        "y": {
          "value": 0
        }
      },
      "mark": {
        "align": "right",
        "baseline": "top",
        "dx": -4,
        "dy": 2,
        "type": "text"
      },
      "transform": [
        {
          "aggregate": [
            {
              "as": "rows",
              "op": "count"
            }
          ]
        }
      ]
    },
    {
      "encoding": {
        "x": {
          "field": "index_low",
          "scale": {
            "domain": [
              95,
              130
            ],
            "nice": false
          },
          "type": "quantitative"
        },
        "x2": {
          "field": "index_high"
        },
        "y": {
          "axis": {
            "labelExpr": "split(datum.label, '|')"
          },
          "field": "label",
          "scale": {
            "paddingInner": 0.3
          },
          "sort": [
            "Smallest misses|0\u20133 g",
            "3\u20135 g",
            "5\u20139 g",
            "9\u201315 g",
            "Largest misses|15 g and up"
          ],
          "title": null,
          "type": "nominal"
        }
      },
      "mark": {
        "color": "#2a78d6",
        "strokeWidth": 2,
        "type": "rule"
      },
      "transform": [
        {
          "filter": "isValid(datum.index_low)"
        }
      ]
    },
    {
      "encoding": {
        "tooltip": [
          {
            "field": "misses",
            "title": "Carbon miss",
            "type": "nominal"
          },
          {
            "field": "half_hours",
            "format": ",",
            "title": "Half-hours",
            "type": "quantitative"
          },
          {
            "field": "mean_shortfall_mwh",
            "format": ",.0f",
            "title": "Mean shortfall, MWh",
            "type": "quantitative"
          },
          {
            "field": "index",
            "format": ".1f",
            "title": "Index",
            "type": "quantitative"
          },
          {
            "field": "index_low",
            "format": ".1f",
            "title": "90% range from",
            "type": "quantitative"
          },
          {
            "field": "index_high",
            "format": ".1f",
            "title": "90% range to",
            "type": "quantitative"
          }
        ],
        "x": {
          "axis": {
            "title": [
              "Shortfall not instructed,",
              "smallest-miss fifth = 100"
            ]
          },
          "field": "index",
          "scale": {
            "domain": [
              95,
              130
            ],
            "nice": false
          },
          "type": "quantitative"
        },
        "y": {
          "axis": {
            "labelExpr": "split(datum.label, '|')"
          },
          "field": "label",
          "scale": {
            "paddingInner": 0.3
          },
          "sort": [
            "Smallest misses|0\u20133 g",
            "3\u20135 g",
            "5\u20139 g",
            "9\u201315 g",
            "Largest misses|15 g and up"
          ],
          "title": null,
          "type": "nominal"
        }
      },
      "mark": {
        "color": "#2a78d6",
        "filled": true,
        "opacity": 1,
        "size": 80,
        "type": "point"
      }
    },
    {
      "encoding": {
        "text": {
          "field": "index_label",
          "type": "nominal"
        },
        "x": {
          "field": "index",
          "type": "quantitative"
        },
        "y": {
          "axis": {
            "labelExpr": "split(datum.label, '|')"
          },
          "field": "label",
          "scale": {
            "paddingInner": 0.3
          },
          "sort": [
            "Smallest misses|0\u20133 g",
            "3\u20135 g",
            "5\u20139 g",
            "9\u201315 g",
            "Largest misses|15 g and up"
          ],
          "title": null,
          "type": "nominal"
        }
      },
      "mark": {
        "baseline": "bottom",
        "dy": -7,
        "type": "text"
      }
    }
  ],
  "title": {
    "anchor": "start",
    "text": {
      "expr": "containerSize()[0] + 0 * width < 700 ? [\"Bigger carbon misses came with\", \"slightly more shortfall, not 25% more\"] : [\"Bigger carbon misses came with slightly more shortfall, not 25% more\"]"
    }
  },
  "transform": [
    {
      "as": "index_label",
      "calculate": "format(datum.index, '.1f')"
    }
  ],
  "width": "container"
}
