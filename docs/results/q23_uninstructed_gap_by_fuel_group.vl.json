  "title": {
    "anchor": "start",
    "subtitle": [
      "Each row is a fuel group, in half-hours",
      "with no instruction. The dot is its typical",
      "unit's gap from plan in a typical month;",
      "the bar spans its best and worst whole",
      "months. Further right is further from plan."
    ],
    "text": {
      "expr": "containerSize()[0] + 0 * width < 700 ? [\"Wind farms stray furthest from their own plans\", \"when NESO has not asked them to change output\"] : [\"Wind farms stray furthest from their own plans when NESO has not asked them to change output\"]"
    }
  },
  "transform": [
    {
      "as": "fuel_group_name",
      "calculate": "datum.fuel_group == \"\" ? \"All fuel groups\" : datum.fuel_group == \"bioenergy\" ? \"Bioenergy\" : datum.fuel_group == \"coal\" ? \"Coal\" : datum.fuel_group == \"gas_turbine\" ? \"Gas\" : datum.fuel_group == \"hydro\" ? \"Hydro\" : datum.fuel_group == \"interconnector\" ? \"Interconnector\" : datum.fuel_group == \"nuclear\" ? \"Nuclear\" : datum.fuel_group == \"oil\" ? \"Oil\" : datum.fuel_group == \"other\" ? \"Other\" : datum.fuel_group == \"pumped_storage\" ? \"Pumped storage\" : datum.fuel_group == \"unclassified\" ? \"Unclassified\" : datum.fuel_group == \"wind\" ? \"Wind\" : datum.fuel_group"
    }
  ],
