{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json",
  "autosize": {
    "contains": "padding",
    "type": "fit-x"
  },
  "config": {
    "view": {
      "continuousHeight": 300,
      "continuousWidth": 300
    }
  },
  "data": {
    "format": {
      "parse": {
        "highest_month_pct": "number",
        "lowest_month_pct": "number",
        "middle_month_p90_pct": "number",
        "middle_month_pct": "number",
        "provisional_month_pct": "number"
      },
      "type": "csv"
    },
    "url": "results/q23_uninstructed_gap_by_fuel_group.csv"
  },
  "description": "Wind farms stray furthest from their plans when NESO leaves them alone",
  "height": 238,
  "layer": [
    {
      "encoding": {
        "tooltip": [
          {
            "field": "fuel_group_name",
            "title": "Fuel group",
            "type": "nominal"
          },
          {
            "field": "lowest_month_pct",
            "format": ".1f",
            "title": "Lowest whole month, %",
            "type": "quantitative"
          },
          {
            "field": "middle_month_pct",
            "format": ".1f",
            "title": "Middle month, %",
            "type": "quantitative"
          },
          {
            "field": "highest_month_pct",
            "format": ".1f",
            "title": "Highest whole month, %",
            "type": "quantitative"
          },
          {
            "field": "provisional_month_pct",
            "format": ".1f",
            "title": "September 2026, %",
            "type": "quantitative"
          },
          {
            "field": "middle_month_p90_pct",
            "format": ".1f",
            "title": "90th percentile, middle month, %",
            "type": "quantitative"
          }
        ],
        "x": {
          "axis": {
            "title": [
              "Gap between plan and meter, % of capacity"
            ]
          },
          "field": "lowest_month_pct",
          "scale": {
            "zero": true
          },
          "type": "quantitative"
        },
        "x2": {
          "field": "highest_month_pct"
        },
        "y": {
          "axis": {
            "labelExpr": "split(datum.label, '|')"
          },
          "field": "fuel_group_name",
          "scale": {
            "paddingInner": 0.3
          },
          "sort": null,
          "title": null,
          "type": "nominal"
        }
      },
      "mark": {
        "color": "#9ec5f4",
        "strokeCap": "round",
        "strokeWidth": 8,
