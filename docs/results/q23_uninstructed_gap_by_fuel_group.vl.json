      }
    },
    {
      "encoding": {
        "tooltip": [
          {
            "field": "fuel_group_name",
            "title": "Fuel group",
            "type": "nominal"
          },
          {
            "field": "lowest_month_pct",
            "format": ".1f",
            "title": "Lowest whole month, %",
