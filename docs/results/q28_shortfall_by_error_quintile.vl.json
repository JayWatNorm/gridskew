{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json",
  "autosize": {
    "contains": "padding",
    "type": "fit-x"
  },
  "config": {
    "view": {
      "continuousHeight": 300,
      "continuousWidth": 300
    }
  },
  "data": {
    "format": {
      "parse": {
        "value": "number"
      },
      "type": "csv"
    },
    "url": "results/q8_q28_history.csv"
  },
  "height": 170,
  "layer": [
    {
      "encoding": {
        "color": {
          "value": "#2a78d6"
        },
        "tooltip": [
          {
            "field": "quintile",
            "title": "Quintile",
            "type": "nominal"
          },
          {
            "field": "range",
            "title": "Quintile of the final forecast's absolute error, gCO2/kWh",
            "type": "nominal"
          },
          {
            "field": "half_hours",
            "title": "Half-hours",
            "type": "nominal"
          },
          {
            "field": "value",
            "format": ".6f",
            "title": "Mean positive unexplained shortfall per half-hour, MWh",
            "type": "quantitative"
          }
        ],
        "x": {
          "field": "value",
          "title": [
            "Mean positive unexplained",
            "shortfall per half-hour, MWh"
          ],
          "type": "quantitative"
        },
        "y": {
          "field": "range",
          "scale": {
            "paddingInner": 0.3
          },
          "sort": null,
          "title": [
            "Quintile of the final forecast's",
            "absolute error, gCO2/kWh"
          ],
          "type": "nominal"
        }
      },
      "mark": {
        "cornerRadiusEnd": 3,
        "type": "bar"
      }
    },
    {
      "encoding": {
        "text": {
          "field": "value",
          "format": ".6f",
          "type": "quantitative"
        },
        "x": {
          "field": "value",
          "title": [
            "Mean positive unexplained",
            "shortfall per half-hour, MWh"
          ],
          "type": "quantitative"
        },
        "y": {
          "field": "range",
          "scale": {
            "paddingInner": 0.3
          },
          "sort": null,
          "title": [
            "Quintile of the final forecast's",
            "absolute error, gCO2/kWh"
          ],
          "type": "nominal"
        }
      },
      "mark": {
        "align": {
          "expr": "datum.value < 0 ? 'right' : 'left'"
        },
        "dx": {
          "expr": "datum.value < 0 ? -4 : 4"
        },
        "type": "text"
      }
    }
  ],
  "title": {
    "anchor": "start",
    "text": {
      "expr": "containerSize()[0] + 0 * width < 700 ? [\"Ratio top over bottom 1.051428 (90% interval\", \"1.027775 to 1.075448): not supported\", \"n=17278 half-hours on 360 days, 2025-08-22\", \"to 2026-08-16; read 2026-10-26 11:21 UTC\"] : [\"Ratio top over bottom 1.051428 (90% interval 1.027775 to 1.075448): not supported\", \"n=17278 half-hours on 360 days, 2025-08-22 to 2026-08-16; read 2026-10-26 11:21 UTC\"]"
    }
  },
  "transform": [
    {
      "filter": {
        "equal": "quintile of abs(error_api_final): mean positive shortfall, MWh",
        "field": "item"
      }
    },
    {
      "as": "range",
      "calculate": "replace(datum.result, \"abs(error_api_final) \", '')"
    }
  ],
  "width": "container"
}
