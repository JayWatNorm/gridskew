{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json",
  "config": {
    "view": {
      "continuousHeight": 300,
      "continuousWidth": 300
    }
  },
  "data": {
    "format": {
      "parse": {
        "value": "number"
      },
      "type": "csv"
    },
    "url": "results/q8_q28_history.csv"
  },
  "encoding": {
    "tooltip": [
      {
        "field": "quintile",
        "type": "nominal"
      },
      {
        "field": "result",
        "type": "nominal"
      },
      {
        "field": "half_hours",
        "type": "nominal"
      },
      {
        "field": "value",
        "type": "quantitative"
      }
    ],
    "x": {
      "field": "value",
      "title": "Mean positive unexplained shortfall per half-hour, MWh",
      "type": "quantitative"
    },
    "y": {
      "axis": {
        "labelExpr": "replace(datum.label, \"abs(error_api_final) \", '')"
      },
      "field": "result",
      "sort": null,
      "title": "Quintile of the final forecast's absolute error, gCO2/kWh",
      "type": "nominal"
    }
  },
  "mark": {
    "color": "#4c72b0",
    "type": "bar"
  },
  "title": {
    "anchor": "start",
    "subtitle": [
      "Ratio top over bottom 1.051428 (90% interval 1.027775",
      "to 1.075448): not supported",
      "n=17278 half-hours on 360 days, 2025-08-22 to",
      "2026-08-16; read 2026-10-26 11:21 UTC"
    ],
    "text": [
      "Q28. Mean positive unexplained shortfall by",
      "quintile of the final carbon forecast's",
      "absolute error"
    ]
  },
  "transform": [
    {
      "filter": {
        "equal": "quintile of abs(error_api_final): mean positive shortfall, MWh",
        "field": "item"
      }
    }
  ],
  "width": "container"
}
