{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json",
  "autosize": {
    "contains": "padding",
    "type": "fit-x"
  },
  "config": {
    "view": {
      "continuousHeight": 300,
      "continuousWidth": 300
    }
  },
  "data": {
    "format": {
      "parse": {
        "mean_absolute_error": "number",
        "mean_error": "number",
        "section": "number"
      },
      "type": "csv"
    },
    "url": "results/q29_final_forecast_error_by_month_and_block.csv"
  },
  "description": "Winter months came out cleaner than forecast, April to July slightly dirtier",
  "height": 220,
  "layer": [
    {
      "encoding": {
        "y": {
          "datum": 0
        }
      },
      "mark": {
        "color": "#8c959f",
        "type": "rule"
      },
      "transform": [
        {
          "aggregate": [
            {
              "as": "rows",
              "op": "count"
            }
          ]
        }
      ]
    },
    {
      "encoding": {
        "x": {
          "axis": {
            "labelAngle": 0,
            "labelExpr": "['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'][toNumber(slice(datum.label, 5, 7)) - 1] + ' ' + slice(datum.label, 2, 4)",
            "labelOverlap": "parity"
          },
          "field": "month",
          "title": null,
          "type": "ordinal"
        },
        "y": {
          "axis": {
            "title": [
              "Average miss, gCO2/kWh",
              "positive: dirtier than forecast"
            ]
          },
          "field": "mean_error",
          "type": "quantitative"
        }
      },
      "mark": {
        "color": "#8c959f",
        "strokeWidth": 2,
        "type": "line"
      }
    },
    {
      "encoding": {
        "color": {
          "field": "direction",
          "legend": null,
          "scale": {
            "domain": [
              "Dirtier than forecast",
              "Cleaner than forecast"
            ],
            "range": [
              "#eb6834",
              "#1baf7a"
            ]
          },
          "type": "nominal"
        },
        "fill": {
          "condition": {
            "test": "datum.part_month",
            "value": "transparent"
          },
          "field": "direction",
          "legend": null,
          "scale": {
            "domain": [
              "Dirtier than forecast",
              "Cleaner than forecast"
            ],
            "range": [
              "#eb6834",
              "#1baf7a"
            ]
          },
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "month",
            "title": "Month",
            "type": "nominal"
          },
          {
            "field": "half_hours",
            "title": "Half-hours",
            "type": "nominal"
          },
          {
            "field": "mean_error",
            "format": "+.1f",
            "title": "Average miss, g/kWh",
            "type": "quantitative"
          },
          {
            "field": "mean_absolute_error",
            "format": ".1f",
            "title": "Average size of the miss, g/kWh",
            "type": "quantitative"
          }
        ],
        "x": {
          "axis": {
            "labelAngle": 0,
            "labelExpr": "['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'][toNumber(slice(datum.label, 5, 7)) - 1] + ' ' + slice(datum.label, 2, 4)",
            "labelOverlap": "parity"
          },
          "field": "month",
          "title": null,
          "type": "ordinal"
        },
        "y": {
          "axis": {
            "title": [
              "Average miss, gCO2/kWh",
              "positive: dirtier than forecast"
            ]
          },
          "field": "mean_error",
          "type": "quantitative"
        }
      },
      "mark": {
        "filled": false,
        "opacity": 1,
        "size": 70,
        "strokeWidth": 2,
        "type": "point"
      }
    }
  ],
  "title": {
    "anchor": "start",
    "text": {
      "expr": "containerSize()[0] + 0 * width < 700 ? [\"Winter months came out cleaner than\", \"forecast, April to July slightly dirtier\"] : [\"Winter months came out cleaner than forecast, April to July slightly dirtier\"]"
    }
  },
  "transform": [
    {
      "filter": {
        "equal": 2,
        "field": "section"
      }
    },
    {
      "as": "month",
      "calculate": "slice(datum.item, 17, 24)"
    },
    {
      "as": "part_month",
      "calculate": "indexof(datum.item, 'partial') >= 0"
    },
    {
      "as": "direction",
      "calculate": "datum.mean_error > 0 ? \"Dirtier than forecast\" : \"Cleaner than forecast\""
    }
  ],
  "width": "container"
}
