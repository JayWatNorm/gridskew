{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json",
  "autosize": {
    "contains": "padding",
    "type": "fit-x"
  },
  "config": {
    "view": {
      "continuousHeight": 300,
      "continuousWidth": 300
    }
  },
  "data": {
    "format": {
      "parse": {
        "median_absolute_pct": "number",
        "p90_absolute_pct": "number",
        "section": "number"
      },
      "type": "csv"
    },
    "url": "results/q23_pn_accuracy_proxy.csv"
  },
  "encoding": {
    "color": {
      "field": "fuel_group_name",
      "legend": {
        "columns": 3,
        "orient": "bottom",
        "symbolStrokeWidth": 3,
        "title": null
      },
      "scale": {
        "domain": [
          "Bioenergy",
          "Coal",
          "Gas turbine",
          "Hydro",
          "Nuclear",
          "Other",
          "Pumped storage",
          "Wind"
        ],
        "range": [
          "#2a78d6",
          "#eb6834",
          "#1baf7a",
          "#eda100",
          "#e87ba4",
          "#a3a19a",
          "#008300",
          "#6250d6"
        ]
      },
      "sort": [
        "Bioenergy",
        "Coal",
        "Gas turbine",
        "Hydro",
        "Nuclear",
        "Other",
        "Pumped storage",
        "Wind"
      ],
      "type": "nominal"
    },
    "detail": {
      "field": "measure_name",
      "type": "nominal"
    },
    "opacity": {
      "condition": [
        {
          "param": "picked_fuel_group",
          "value": 1
        }
      ],
      "value": 0.15
    },
    "strokeDash": {
      "field": "measure_name",
      "legend": null,
      "sort": [
        "Median",
        "90th percentile"
      ],
      "type": "nominal"
    },
    "tooltip": [
      {
        "field": "fuel_group_name",
        "title": "Fuel group",
        "type": "nominal"
      },
      {
        "field": "settlement_month",
        "title": "Month",
        "type": "nominal"
      },
      {
        "field": "units",
        "title": "Units",
        "type": "nominal"
      },
      {
        "field": "half_hours",
        "title": "Half-hours",
        "type": "nominal"
      },
      {
        "field": "measure_name",
        "title": "Measure",
        "type": "nominal"
      },
      {
        "field": "value",
        "format": ".3f",
        "title": "Absolute % of capacity",
        "type": "quantitative"
      }
    ],
    "x": {
      "axis": {
        "labelAngle": 0,
        "labelExpr": "slice(datum.label, 0, 7)",
        "labelOverlap": "parity"
      },
      "field": "settlement_month",
      "title": null,
      "type": "ordinal"
    },
    "y": {
      "field": "value",
      "title": "Absolute deviation from PN, % of capacity",
      "type": "quantitative"
    }
  },
  "height": 320,
  "mark": {
    "strokeCap": "round",
    "strokeJoin": "round",
    "strokeWidth": 2,
    "type": "line"
  },
  "params": [
    {
      "bind": "legend",
      "name": "picked_fuel_group",
      "select": {
        "fields": [
          "fuel_group_name"
        ],
        "type": "point"
      }
    }
  ],
  "title": {
    "anchor": "start",
    "text": {
      "expr": "containerSize()[0] + 0 * width < 700 ? [\"Median (solid) and 90th percentile\", \"(dashed) of the absolute % across\", \"unit-months; a proxy, not NESO's measure\", \"Months 2025-08 to 2026-09; cutoff\", \"2026-09-30 22:30 UTC; units and\", \"half-hours per point in the CSV\"] : [\"Median (solid) and 90th percentile (dashed) of the\", \"absolute % across unit-months; a proxy, not NESO's measure\", \"Months 2025-08 to 2026-09; cutoff 2026-09-30 22:30 UTC; units and half-hours per point in the CSV\"]"
    }
  },
  "transform": [
    {
      "filter": {
        "equal": 1,
        "field": "section"
      }
    },
    {
      "as": [
        "measure",
        "value"
      ],
      "fold": [
        "median_absolute_pct",
        "p90_absolute_pct"
      ]
    },
    {
      "as": "fuel_group_name",
      "calculate": "datum.fuel_group == \"\" ? \"All fuel groups\" : datum.fuel_group == \"bioenergy\" ? \"Bioenergy\" : datum.fuel_group == \"coal\" ? \"Coal\" : datum.fuel_group == \"gas_turbine\" ? \"Gas turbine\" : datum.fuel_group == \"hydro\" ? \"Hydro\" : datum.fuel_group == \"interconnector\" ? \"Interconnector\" : datum.fuel_group == \"nuclear\" ? \"Nuclear\" : datum.fuel_group == \"oil\" ? \"Oil\" : datum.fuel_group == \"other\" ? \"Other\" : datum.fuel_group == \"pumped_storage\" ? \"Pumped storage\" : datum.fuel_group == \"unclassified\" ? \"Unclassified\" : datum.fuel_group == \"wind\" ? \"Wind\" : datum.fuel_group"
    },
    {
      "as": "measure_name",
      "calculate": "datum.measure == \"median_absolute_pct\" ? \"Median\" : datum.measure == \"p90_absolute_pct\" ? \"90th percentile\" : datum.measure"
    }
  ],
  "width": "container"
}
