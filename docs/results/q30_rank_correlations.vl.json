{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json",
  "autosize": {
    "contains": "padding",
    "type": "fit-x"
  },
  "config": {
    "view": {
      "continuousHeight": 300,
      "continuousWidth": 300
    }
  },
  "data": {
    "format": {
      "parse": {
        "high": "number",
        "low": "number",
        "rho": "number"
      },
      "type": "csv"
    },
    "url": "results/q30_rank_correlations.csv"
  },
  "description": "The sizes of wind and carbon forecast misses barely move together; their directions are weakly linked",
  "height": 176,
  "layer": [
    {
      "encoding": {
        "x": {
          "datum": 0,
          "scale": {
            "domain": [
              -0.3,
              0.3
            ],
            "nice": false
          }
        }
      },
      "mark": {
        "color": "#8c959f",
        "type": "rule"
      },
      "name": "zero line",
      "transform": [
        {
          "aggregate": [
            {
              "as": "rows",
              "op": "count"
            }
          ]
        }
      ]
    },
    {
      "encoding": {
        "stroke": {
          "field": "key",
          "legend": {
            "direction": "vertical",
            "labelLimit": 0,
            "orient": "bottom",
            "symbolOpacity": 1,
            "symbolSize": 110,
            "symbolStrokeWidth": 2,
            "title": null
          },
          "scale": {
            "domain": [
              "Rank correlation",
              "90% range"
            ],
            "range": [
              "#6e7781",
              "#6e7781"
            ]
          },
          "type": "nominal"
        },
        "x": {
          "field": "low",
          "scale": {
            "domain": [
              -0.3,
              0.3
            ],
            "nice": false
          },
          "type": "quantitative"
        },
        "x2": {
          "field": "high"
        },
        "y": {
          "axis": {
            "labelExpr": "split(datum.label, '|')"
          },
          "field": "label",
          "scale": {
            "paddingInner": 0.3
          },
          "sort": [
            "Size of misses|turned-down wind added back",
            "Direction|turned-down wind added back",
            "Size of misses|delivered wind",
            "Direction|delivered wind"
          ],
          "title": null,
          "type": "nominal"
        }
      },
      "mark": {
        "strokeWidth": 2,
        "type": "rule"
      },
      "transform": [
        {
          "as": "key",
          "calculate": "\"90% range\""
        }
      ]
    },
    {
      "encoding": {
        "fill": {
          "field": "key",
          "legend": {
            "direction": "vertical",
            "labelLimit": 0,
            "orient": "bottom",
            "symbolOpacity": 1,
            "symbolSize": 110,
            "symbolStrokeWidth": 2,
            "title": null
          },
          "scale": {
            "domain": [
              "Rank correlation",
              "90% range"
            ],
            "range": [
              "#6e7781",
              "transparent"
            ]
          },
          "type": "nominal"
        },
        "shape": {
          "field": "key",
          "legend": {
            "direction": "vertical",
            "labelLimit": 0,
            "orient": "bottom",
            "symbolOpacity": 1,
            "symbolSize": 110,
            "symbolStrokeWidth": 2,
            "title": null
          },
          "scale": {
            "domain": [
              "Rank correlation",
              "90% range"
            ],
            "range": [
              "circle",
              "M-1,0H1"
            ]
          },
          "type": "nominal"
        },
        "stroke": {
          "field": "key",
          "legend": {
            "direction": "vertical",
            "labelLimit": 0,
            "orient": "bottom",
            "symbolOpacity": 1,
            "symbolSize": 110,
            "symbolStrokeWidth": 2,
            "title": null
          },
          "scale": {
            "domain": [
              "Rank correlation",
              "90% range"
            ],
            "range": [
              "#6e7781",
              "#6e7781"
            ]
          },
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "measure",
            "title": "Measure",
            "type": "nominal"
          },
          {
            "field": "rho",
            "format": "+.2f",
            "title": "Rank correlation",
            "type": "quantitative"
          },
          {
            "field": "low",
            "format": "+.2f",
            "title": "90% range from",
            "type": "quantitative"
          },
          {
            "field": "high",
            "format": "+.2f",
            "title": "90% range to",
            "type": "quantitative"
          }
        ],
        "x": {
          "axis": {
            "title": [
              "Rank correlation with",
              "the carbon forecast's miss"
            ]
          },
          "field": "rho",
          "scale": {
            "domain": [
              -0.3,
              0.3
            ],
            "nice": false
          },
          "type": "quantitative"
        },
        "y": {
          "axis": {
            "labelExpr": "split(datum.label, '|')"
          },
          "field": "label",
          "scale": {
            "paddingInner": 0.3
          },
          "sort": [
            "Size of misses|turned-down wind added back",
            "Direction|turned-down wind added back",
            "Size of misses|delivered wind",
            "Direction|delivered wind"
          ],
          "title": null,
          "type": "nominal"
        }
      },
      "mark": {
        "filled": false,
        "opacity": 1,
        "size": 80,
        "strokeWidth": 2,
        "type": "point"
      },
      "transform": [
        {
          "as": "key",
          "calculate": "\"Rank correlation\""
        }
      ]
    },
    {
      "encoding": {
        "text": {
          "field": "rho_label",
          "type": "nominal"
        },
        "x": {
          "field": "rho",
          "type": "quantitative"
        },
        "y": {
          "axis": {
            "labelExpr": "split(datum.label, '|')"
          },
          "field": "label",
          "scale": {
            "paddingInner": 0.3
          },
          "sort": [
            "Size of misses|turned-down wind added back",
            "Direction|turned-down wind added back",
            "Size of misses|delivered wind",
            "Direction|delivered wind"
          ],
          "title": null,
          "type": "nominal"
        }
      },
      "mark": {
        "baseline": "bottom",
        "dy": -7,
        "type": "text"
      }
    }
  ],
  "title": {
    "anchor": "start",
    "subtitle": {
      "signal": "containerSize()[0] + 0 * width < 400 ? [\"Each row compares the two misses one way: the dot is\", \"the rank correlation, the line its 90% range. Zero\", \"means no steady link.\"] : (containerSize()[0] + 0 * width < 480 ? [\"Each row compares the two misses one way: the dot is the rank\", \"correlation, the line its 90% range. Zero means no steady link.\"] : (containerSize()[0] + 0 * width < 560 ? [\"Each row compares the two misses one way: the dot is the rank correlation, the\", \"line its 90% range. Zero means no steady link.\"] : (containerSize()[0] + 0 * width < 640 ? [\"Each row compares the two misses one way: the dot is the rank correlation, the line its 90%\", \"range. Zero means no steady link.\"] : (containerSize()[0] + 0 * width < 720 ? [\"Each row compares the two misses one way: the dot is the rank correlation, the line its 90% range. Zero\", \"means no steady link.\"] : ([\"Each row compares the two misses one way: the dot is the rank correlation, the line its 90% range. Zero means no steady\", \"link.\"])))))"
    },
    "text": {
      "expr": "containerSize()[0] + 0 * width < 400 ? [\"The sizes of wind and carbon forecast misses\", \"barely move together; their directions are\", \"weakly linked\"] : (containerSize()[0] + 0 * width < 480 ? [\"The sizes of wind and carbon forecast misses barely move\", \"together; their directions are weakly linked\"] : (containerSize()[0] + 0 * width < 560 ? [\"The sizes of wind and carbon forecast misses barely move together;\", \"their directions are weakly linked\"] : (containerSize()[0] + 0 * width < 640 ? [\"The sizes of wind and carbon forecast misses barely move together; their\", \"directions are weakly linked\"] : (containerSize()[0] + 0 * width < 720 ? [\"The sizes of wind and carbon forecast misses barely move together; their directions are weakly\", \"linked\"] : ([\"The sizes of wind and carbon forecast misses barely move together; their directions are weakly linked\"])))))"
    }
  },
  "transform": [
    {
      "as": "rho_label",
      "calculate": "format(datum.rho, '+.2f')"
    }
  ],
  "width": "container"
}
