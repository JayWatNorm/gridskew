{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json",
  "config": {
    "view": {
      "continuousHeight": 300,
      "continuousWidth": 300
    }
  },
  "data": {
    "format": {
      "parse": {
        "median_lag_minutes": "number",
        "p90_lag_minutes": "number",
        "section": "number"
      },
      "type": "csv"
    },
    "url": "results/q6_publication_lag.csv"
  },
  "encoding": {
    "color": {
      "field": "measure",
      "legend": {
        "labelExpr": "datum.label == \"median_lag_minutes\" ? \"median\" : datum.label == \"p90_lag_minutes\" ? \"90th percentile\" : datum.label",
        "orient": "bottom",
        "title": null
      },
      "scale": {
        "domain": [
          "median_lag_minutes",
          "p90_lag_minutes"
        ],
        "range": [
          "#4c72b0",
          "#dd8452"
        ]
      },
      "sort": [
        "median_lag_minutes",
        "p90_lag_minutes"
      ],
      "type": "nominal"
    },
    "tooltip": [
      {
        "field": "outage_class",
        "type": "nominal"
      },
      {
        "field": "notices",
        "type": "nominal"
      },
      {
        "field": "measure",
        "type": "nominal"
      },
      {
        "field": "value",
        "type": "quantitative"
      }
    ],
    "x": {
      "field": "value",
      "title": "Lag from event start to first publication, minutes",
      "type": "quantitative"
    },
    "y": {
      "field": "outage_class",
      "sort": null,
      "title": null,
      "type": "nominal"
    },
    "yOffset": {
      "field": "measure",
      "sort": [
        "median_lag_minutes",
        "p90_lag_minutes"
      ],
      "type": "nominal"
    }
  },
  "mark": {
    "type": "bar"
  },
  "title": {
    "anchor": "start",
    "subtitle": [
      "Minutes; negative means published before the event",
      "starts",
      "n=20368 notices, first publications from 2024-11-01 to",
      "the read on 2026-10-12; 12 notices with no class are",
      "not drawn"
    ],
    "text": [
      "Q6. Lag from event start to first REMIT",
      "publication, by outage class"
    ]
  },
  "transform": [
    {
      "filter": {
        "equal": 1,
        "field": "section"
      }
    },
    {
      "filter": {
        "field": "outage_class",
        "oneOf": [
          "Planned",
          "Unplanned"
        ]
      }
    },
    {
      "as": [
        "measure",
        "value"
      ],
      "fold": [
        "median_lag_minutes",
        "p90_lag_minutes"
      ]
    }
  ],
  "width": "container"
}
