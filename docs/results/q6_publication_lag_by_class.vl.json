{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json",
  "autosize": {
    "contains": "padding",
    "type": "fit-x"
  },
  "config": {
    "view": {
      "continuousHeight": 300,
      "continuousWidth": 300
    }
  },
  "data": {
    "format": {
      "parse": {
        "median_lag_minutes": "number",
        "p90_lag_minutes": "number",
        "section": "number"
      },
      "type": "csv"
    },
    "url": "results/q6_publication_lag.csv"
  },
  "height": 84,
  "layer": [
    {
      "encoding": {
        "color": {
          "field": "measure_name",
          "legend": {
            "columns": 2,
            "orient": "bottom",
            "title": null
          },
          "scale": {
            "domain": [
              "Median",
              "90th percentile"
            ],
            "range": [
              "#2a78d6",
              "#eb6834"
            ]
          },
          "sort": [
            "Median",
            "90th percentile"
          ],
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "outage_class",
            "title": "Outage class",
            "type": "nominal"
          },
          {
            "field": "notices",
            "title": "Notices",
            "type": "nominal"
          },
          {
            "field": "measure_name",
            "title": "Measure",
            "type": "nominal"
          },
          {
            "field": "value",
            "format": ",.1f",
            "title": "Minutes",
            "type": "quantitative"
          }
        ],
        "x": {
          "field": "value",
          "scale": {
            "padding": 56
          },
          "title": "Lag from event start to first publication, minutes",
          "type": "quantitative"
        },
        "y": {
          "field": "outage_class",
          "scale": {
            "paddingInner": 0.3
          },
          "sort": null,
          "title": null,
          "type": "nominal"
        },
        "yOffset": {
          "field": "measure_name",
          "scale": {
            "paddingInner": 0.15
          },
          "sort": [
            "Median",
            "90th percentile"
          ],
          "type": "nominal"
        }
      },
      "mark": {
        "cornerRadiusEnd": 3,
        "type": "bar"
      }
    },
    {
      "encoding": {
        "text": {
          "field": "value",
          "format": ",.1f",
          "type": "quantitative"
        },
        "x": {
          "field": "value",
          "scale": {
            "padding": 56
          },
          "title": "Lag from event start to first publication, minutes",
          "type": "quantitative"
        },
        "y": {
          "field": "outage_class",
          "scale": {
            "paddingInner": 0.3
          },
          "sort": null,
          "title": null,
          "type": "nominal"
        },
        "yOffset": {
          "field": "measure_name",
          "scale": {
            "paddingInner": 0.15
          },
          "sort": [
            "Median",
            "90th percentile"
          ],
          "type": "nominal"
        }
      },
      "mark": {
        "align": {
          "expr": "datum.value < 0 ? 'right' : 'left'"
        },
        "dx": {
          "expr": "datum.value < 0 ? -4 : 4"
        },
        "type": "text"
      }
    }
  ],
  "title": {
    "anchor": "start",
    "text": {
      "expr": "containerSize()[0] + 0 * width < 700 ? [\"Minutes; negative means published\", \"before the event starts\", \"n=20368 notices, first publications from\", \"2024-11-01 to the read on 2026-10-12; 12\", \"notices with no class are not drawn\"] : [\"Minutes; negative means published before the event starts\", \"n=20368 notices, first publications from 2024-11-01 to the\", \"read on 2026-10-12; 12 notices with no class are not drawn\"]"
    }
  },
  "transform": [
    {
      "filter": {
        "equal": 1,
        "field": "section"
      }
    },
    {
      "filter": {
        "field": "outage_class",
        "oneOf": [
          "Planned",
          "Unplanned"
        ]
      }
    },
    {
      "as": [
        "measure",
        "value"
      ],
      "fold": [
        "median_lag_minutes",
        "p90_lag_minutes"
      ]
    },
    {
      "as": "measure_name",
      "calculate": "datum.measure == \"median_lag_minutes\" ? \"Median\" : datum.measure == \"p90_lag_minutes\" ? \"90th percentile\" : datum.measure"
    }
  ],
  "width": "container"
}
