{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json",
  "autosize": {
    "contains": "padding",
    "type": "fit-x"
  },
  "config": {
    "view": {
      "continuousHeight": 300,
      "continuousWidth": 300
    }
  },
  "data": {
    "format": {
      "parse": {
        "mean_absolute_error": "number",
        "mean_error": "number",
        "section": "number"
      },
      "type": "csv"
    },
    "url": "results/q29_final_forecast_error_by_month_and_block.csv"
  },
  "height": 168,
  "layer": [
    {
      "encoding": {
        "color": {
          "field": "measure_name",
          "legend": {
            "columns": 1,
            "orient": "bottom",
            "title": null
          },
          "scale": {
            "domain": [
              "Mean error",
              "Mean absolute error"
            ],
            "range": [
              "#2a78d6",
              "#eb6834"
            ]
          },
          "sort": [
            "Mean error",
            "Mean absolute error"
          ],
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "period",
            "title": "UTC block",
            "type": "nominal"
          },
          {
            "field": "half_hours",
            "title": "Half-hours",
            "type": "nominal"
          },
          {
            "field": "measure_name",
            "title": "Measure",
            "type": "nominal"
          },
          {
            "field": "value",
            "format": ".3f",
            "title": "gCO2/kWh",
            "type": "quantitative"
          },
          {
            "field": "median_error",
            "title": "Median error",
            "type": "nominal"
          },
          {
            "field": "zero_error_share",
            "title": "Share with no error",
            "type": "nominal"
          }
        ],
        "x": {
          "field": "value",
          "scale": {
            "padding": 56
          },
          "title": "gCO2/kWh",
          "type": "quantitative"
        },
        "y": {
          "field": "period",
          "scale": {
            "paddingInner": 0.3
          },
          "sort": null,
          "title": null,
          "type": "nominal"
        },
        "yOffset": {
          "field": "measure_name",
          "scale": {
            "paddingInner": 0.15
          },
          "sort": [
            "Mean error",
            "Mean absolute error"
          ],
          "type": "nominal"
        }
      },
      "mark": {
        "cornerRadiusEnd": 3,
        "type": "bar"
      }
    },
    {
      "encoding": {
        "text": {
          "field": "value",
          "format": ".3f",
          "type": "quantitative"
        },
        "x": {
          "field": "value",
          "scale": {
            "padding": 56
          },
          "title": "gCO2/kWh",
          "type": "quantitative"
        },
        "y": {
          "field": "period",
          "scale": {
            "paddingInner": 0.3
          },
          "sort": null,
          "title": null,
          "type": "nominal"
        },
        "yOffset": {
          "field": "measure_name",
          "scale": {
            "paddingInner": 0.15
          },
          "sort": [
            "Mean error",
            "Mean absolute error"
          ],
          "type": "nominal"
        }
      },
      "mark": {
        "align": {
          "expr": "datum.value < 0 ? 'right' : 'left'"
        },
        "dx": {
          "expr": "datum.value < 0 ? -4 : 4"
        },
        "type": "text"
      }
    }
  ],
  "title": {
    "anchor": "start",
    "text": {
      "expr": "containerSize()[0] + 0 * width < 700 ? [\"gCO2/kWh, actual minus forecast:\", \"positive means dirtier than forecast\", \"n=17280 half-hours, settlement\", \"dates 2025-08-22 to 2026-08-16;\", \"read 2026-10-27 06:15 UTC\"] : [\"gCO2/kWh, actual minus forecast: positive means dirtier than forecast\", \"n=17280 half-hours, settlement dates 2025-08-22 to 2026-08-16; read 2026-10-27 06:15 UTC\"]"
    }
  },
  "transform": [
    {
      "filter": {
        "equal": 3,
        "field": "section"
      }
    },
    {
      "as": [
        "measure",
        "value"
      ],
      "fold": [
        "mean_error",
        "mean_absolute_error"
      ]
    },
    {
      "as": "period",
      "calculate": "replace(datum.item, \"UTC block \", '')"
    },
    {
      "as": "measure_name",
      "calculate": "datum.measure == \"mean_error\" ? \"Mean error\" : datum.measure == \"mean_absolute_error\" ? \"Mean absolute error\" : datum.measure"
    }
  ],
  "width": "container"
}
