{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json",
  "config": {
    "view": {
      "continuousHeight": 300,
      "continuousWidth": 300
    }
  },
  "data": {
    "format": {
      "parse": {
        "value": "number"
      },
      "type": "csv"
    },
    "url": "results/q30_wind_vs_carbon_error.csv"
  },
  "encoding": {
    "tooltip": [
      {
        "field": "quintile",
        "type": "nominal"
      },
      {
        "field": "result",
        "type": "nominal"
      },
      {
        "field": "half_hours",
        "type": "nominal"
      },
      {
        "field": "value",
        "type": "quantitative"
      }
    ],
    "x": {
      "field": "value",
      "title": "Mean absolute error of the final carbon forecast, gCO2/kWh",
      "type": "quantitative"
    },
    "y": {
      "axis": {
        "labelExpr": "replace(datum.label, \"abs(wind error) \", '')"
      },
      "field": "result",
      "sort": null,
      "title": "Quintile of the absolute wind forecast miss",
      "type": "nominal"
    }
  },
  "mark": {
    "color": "#4c72b0",
    "type": "bar"
  },
  "title": {
    "anchor": "start",
    "subtitle": [
      "Rank correlation of the two misses 0.007930 (90%",
      "interval -0.012829 to 0.028041)",
      "n=17280 half-hours on 360 days, 2025-08-22 to",
      "2026-08-16; read 2026-10-27, database cutoff 14:03 UTC"
    ],
    "text": [
      "Q30. Mean absolute carbon forecast error by",
      "quintile of the wind forecast miss"
    ]
  },
  "transform": [
    {
      "filter": {
        "equal": "quintile of abs(wind error, outturn with cohort curtailment add-back): mean abs(error_api_final)",
        "field": "item"
      }
    }
  ],
  "width": "container"
}
