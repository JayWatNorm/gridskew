{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json",
  "autosize": {
    "contains": "padding",
    "type": "fit-x"
  },
  "config": {
    "view": {
      "continuousHeight": 300,
      "continuousWidth": 300
    }
  },
  "data": {
    "format": {
      "parse": {
        "section": "number",
        "under_10_minutes_pct": "number"
      },
      "type": "csv"
    },
    "url": "results/q25_instruction_fragmentation.csv"
  },
  "height": 252,
  "layer": [
    {
      "encoding": {
        "color": {
          "field": "measure_name",
          "legend": {
            "columns": 1,
            "orient": "bottom",
            "title": null
          },
          "scale": {
            "domain": [
              "Continuous acceptance duration (BSC)",
              "Own span of each acceptance"
            ],
            "range": [
              "#2a78d6",
              "#eb6834"
            ]
          },
          "sort": [
            "Continuous acceptance duration (BSC)",
            "Own span of each acceptance"
          ],
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "fuel_group_name",
            "title": "Fuel group",
            "type": "nominal"
          },
          {
            "field": "measure_name",
            "title": "Measure",
            "type": "nominal"
          },
          {
            "field": "n",
            "title": "Acceptances",
            "type": "nominal"
          },
          {
            "field": "under_10_minutes",
            "title": "Under 10 minutes",
            "type": "nominal"
          },
          {
            "field": "under_10_minutes_pct",
            "format": ".1f",
            "title": "Under 10 minutes, % of acceptances",
            "type": "quantitative"
          },
          {
            "field": "median_minutes",
            "title": "Median minutes",
            "type": "nominal"
          }
        ],
        "x": {
          "axis": {
            "values": [
              0,
              25,
              50,
              75,
              100
            ]
          },
          "field": "under_10_minutes_pct",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "title": "Under 10 minutes, % of acceptances",
          "type": "quantitative"
        },
        "y": {
          "field": "fuel_group_name",
          "scale": {
            "paddingInner": 0.3
          },
          "sort": null,
          "title": null,
          "type": "nominal"
        },
        "yOffset": {
          "field": "measure_name",
          "scale": {
            "paddingInner": 0.15
          },
          "sort": [
            "Continuous acceptance duration (BSC)",
            "Own span of each acceptance"
          ],
          "type": "nominal"
        }
      },
      "mark": {
        "cornerRadiusEnd": 3,
        "type": "bar"
      }
    },
    {
      "encoding": {
        "text": {
          "field": "under_10_minutes_pct",
          "format": ".1f",
          "type": "quantitative"
        },
        "x": {
          "axis": {
            "values": [
              0,
              25,
              50,
              75,
              100
            ]
          },
          "field": "under_10_minutes_pct",
          "scale": {
            "domain": [
              0,
              100
            ]
          },
          "title": "Under 10 minutes, % of acceptances",
          "type": "quantitative"
        },
        "y": {
          "field": "fuel_group_name",
          "scale": {
            "paddingInner": 0.3
          },
          "sort": null,
          "title": null,
          "type": "nominal"
        },
        "yOffset": {
          "field": "measure_name",
          "scale": {
            "paddingInner": 0.15
          },
          "sort": [
            "Continuous acceptance duration (BSC)",
            "Own span of each acceptance"
          ],
          "type": "nominal"
        }
      },
      "mark": {
        "align": {
          "expr": "datum.under_10_minutes_pct < 0 ? 'right' : 'left'"
        },
        "dx": {
          "expr": "datum.under_10_minutes_pct < 0 ? -4 : 4"
        },
        "type": "text"
      }
    }
  ],
  "title": {
    "anchor": "start",
    "text": {
      "expr": "containerSize()[0] + 0 * width < 700 ? [\"Continuous acceptance duration as\", \"the BSC chains acceptances, with\", \"each acceptance's own span beside it\", \"Months 2025-08 to 2026-09; cutoff 2026-09-30\", \"22:30 UTC; acceptances per group in the CSV\"] : [\"Continuous acceptance duration as the BSC chains\", \"acceptances, with each acceptance's own span beside it\", \"Months 2025-08 to 2026-09; cutoff 2026-09-30 22:30 UTC; acceptances per group in the CSV\"]"
    }
  },
  "transform": [
    {
      "filter": {
        "equal": 2,
        "field": "section"
      }
    },
    {
      "filter": {
        "field": "measure",
        "oneOf": [
          "2 continuous acceptance duration, BSC (acceptances)",
          "1 dispatch granularity (acceptances)"
        ]
      }
    },
    {
      "as": "fuel_group_name",
      "calculate": "datum.fuel_group == \"\" ? \"All fuel groups\" : datum.fuel_group == \"bioenergy\" ? \"Bioenergy\" : datum.fuel_group == \"coal\" ? \"Coal\" : datum.fuel_group == \"gas_turbine\" ? \"Gas turbine\" : datum.fuel_group == \"hydro\" ? \"Hydro\" : datum.fuel_group == \"interconnector\" ? \"Interconnector\" : datum.fuel_group == \"nuclear\" ? \"Nuclear\" : datum.fuel_group == \"oil\" ? \"Oil\" : datum.fuel_group == \"other\" ? \"Other\" : datum.fuel_group == \"pumped_storage\" ? \"Pumped storage\" : datum.fuel_group == \"unclassified\" ? \"Unclassified\" : datum.fuel_group == \"wind\" ? \"Wind\" : datum.fuel_group"
    },
    {
      "as": "measure_name",
      "calculate": "datum.measure == \"2 continuous acceptance duration, BSC (acceptances)\" ? \"Continuous acceptance duration (BSC)\" : datum.measure == \"1 dispatch granularity (acceptances)\" ? \"Own span of each acceptance\" : datum.measure"
    }
  ],
  "width": "container"
}
