            ]
          },
          "type": "nominal"
        },
        "shape": {
          "field": "key",
          "legend": {
            "direction": "vertical",
            "labelLimit": 0,
            "orient": "bottom",
            "symbolOpacity": 1,
            "symbolSize": 110,
            "symbolStrokeWidth": 2,
            "title": null
          },
          "scale": {
            "domain": [
              "Joined with follow-ons (Elexon's test)",
              "Each instruction on its own"
            ],
            "range": [
              "circle",
              "circle"
            ]
          },
          "type": "nominal"
        },
        "stroke": {
          "field": "key",
          "legend": {
            "direction": "vertical",
            "labelLimit": 0,
            "orient": "bottom",
            "symbolOpacity": 1,
            "symbolSize": 110,
            "symbolStrokeWidth": 2,
            "title": null
          },
          "scale": {
            "domain": [
              "Joined with follow-ons (Elexon's test)",
              "Each instruction on its own"
            ],
            "range": [
              "#2a78d6",
              "#8c959f"
            ]
          },
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "fuel_group_name",
            "title": "Fuel group",
            "type": "nominal"
          },
          {
            "field": "instructions",
            "format": ",",
            "title": "Instructions",
            "type": "quantitative"
          },
          {
            "field": "short_joined_pct",
            "format": ".2r",
            "title": "Short, joined, %",
            "type": "quantitative"
          },
          {
            "field": "short_on_its_own_pct",
            "format": ".2r",
            "title": "Short on its own, %",
            "type": "quantitative"
          }
        ],
        "x": {
          "field": "short_joined_pct",
          "type": "quantitative"
        },
        "y": {
          "axis": {
            "labelExpr": "split(datum.label, '|')"
          },
          "field": "fuel_group_name",
          "scale": {
            "paddingInner": 0.3
          },
          "sort": null,
          "title": null,
          "type": "nominal"
        }
      },
      "mark": {
        "filled": false,
        "opacity": 1,
        "size": 80,
        "strokeWidth": 2,
        "type": "point"
      },
      "transform": [
        {
          "as": "key",
          "calculate": "\"Joined with follow-ons (Elexon's test)\""
        }
      ]
    },
    {
      "encoding": {
        "text": {
          "field": "joined_label",
          "type": "nominal"
        },
        "x": {
          "field": "short_joined_pct",
          "type": "quantitative"
        },
        "y": {
          "axis": {
            "labelExpr": "split(datum.label, '|')"
          },
          "field": "fuel_group_name",
          "scale": {
            "paddingInner": 0.3
          },
          "sort": null,
          "title": null,
          "type": "nominal"
        }
      },
      "mark": {
        "baseline": "bottom",
        "dy": -7,
        "type": "text"
      }
    }
  ],
  "title": {
    "anchor": "start",
    "subtitle": [
      "Each row is a fuel group. The dot is the share",
      "of its instructions under 10 minutes once",
      "follow-on instructions are joined, Elexon's",
      "test; the ring counts each on its own. Each",
      "step on the scale is ten times the last."
    ],
    "text": {
      "expr": "containerSize()[0] + 0 * width < 700 ? [\"Batteries (the other group) and\", \"pumped storage get far more short\", \"instructions than power stations\"] : [\"Batteries (the other group) and pumped storage get far more short instructions than power stations\"]"
    }
  },
  "transform": [
    {
      "as": "fuel_group_name",
      "calculate": "datum.fuel_group == \"\" ? \"All fuel groups\" : datum.fuel_group == \"bioenergy\" ? \"Bioenergy\" : datum.fuel_group == \"coal\" ? \"Coal\" : datum.fuel_group == \"gas_turbine\" ? \"Gas\" : datum.fuel_group == \"hydro\" ? \"Hydro\" : datum.fuel_group == \"interconnector\" ? \"Interconnector\" : datum.fuel_group == \"nuclear\" ? \"Nuclear\" : datum.fuel_group == \"oil\" ? \"Oil\" : datum.fuel_group == \"other\" ? \"Other\" : datum.fuel_group == \"pumped_storage\" ? \"Pumped storage\" : datum.fuel_group == \"unclassified\" ? \"Unclassified\" : datum.fuel_group == \"wind\" ? \"Wind\" : datum.fuel_group"
    },
    {
      "as": "joined_label",
      "calculate": "format(datum.short_joined_pct, '.2r') + '%'"
    }
  ],
  "width": "container"
}
