{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.4.1.json",
  "autosize": {
    "contains": "padding",
    "type": "fit-x"
  },
  "config": {
    "view": {
      "continuousHeight": 300,
      "continuousWidth": 300
    }
  },
  "data": {
    "format": {
      "parse": {
        "instructions": "number",
        "short_joined_as_first_read_pct": "number",
        "short_joined_pct": "number",
        "short_on_its_own_pct": "number"
      },
      "type": "csv"
    },
    "url": "results/q25_short_instructions_by_fuel_group.csv"
  },
  "description": "Batteries (the other group) and pumped storage get far more short instructions than power stations",
  "height": 264,
  "layer": [
    {
      "encoding": {
        "x": {
          "axis": {
            "labelExpr": "format(datum.value, '~r') + '%'",
            "title": [
              "Instructions under 10 minutes, % (log scale)"
            ],
            "values": [
              0.01,
              0.1,
              1,
              10,
              100
            ]
          },
          "field": "short_joined_pct",
          "scale": {
            "domain": [
              0.01,
              100
            ],
            "type": "log"
          },
          "type": "quantitative"
        },
        "x2": {
          "field": "short_on_its_own_pct"
        },
        "y": {
          "axis": {
            "labelExpr": "split(datum.label, '|')"
          },
          "field": "fuel_group_name",
          "scale": {
            "paddingInner": 0.3
          },
          "sort": null,
          "title": null,
          "type": "nominal"
        }
      },
      "mark": {
        "color": "#8c959f",
        "strokeWidth": 1.5,
        "type": "rule"
      },
      "name": "connector"
    },
    {
      "encoding": {
        "fill": {
          "field": "key",
          "legend": {
            "direction": "vertical",
            "labelLimit": 0,
            "orient": "bottom",
            "symbolOpacity": 1,
            "symbolSize": 110,
            "symbolStrokeWidth": 2,
            "title": null
          },
          "scale": {
            "domain": [
              "Joined with follow-ons (Elexon's test)",
              "Each instruction on its own"
            ],
            "range": [
              "#2a78d6",
              "transparent"
            ]
          },
          "type": "nominal"
        },
        "shape": {
          "field": "key",
          "legend": {
            "direction": "vertical",
            "labelLimit": 0,
            "orient": "bottom",
            "symbolOpacity": 1,
            "symbolSize": 110,
            "symbolStrokeWidth": 2,
            "title": null
          },
          "scale": {
            "domain": [
              "Joined with follow-ons (Elexon's test)",
              "Each instruction on its own"
            ],
            "range": [
              "circle",
              "circle"
            ]
          },
          "type": "nominal"
        },
        "stroke": {
          "field": "key",
          "legend": {
            "direction": "vertical",
            "labelLimit": 0,
            "orient": "bottom",
            "symbolOpacity": 1,
            "symbolSize": 110,
            "symbolStrokeWidth": 2,
            "title": null
          },
          "scale": {
            "domain": [
              "Joined with follow-ons (Elexon's test)",
              "Each instruction on its own"
            ],
            "range": [
              "#2a78d6",
              "#8c959f"
            ]
          },
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "fuel_group_name",
            "title": "Fuel group",
            "type": "nominal"
          },
          {
            "field": "instructions",
            "format": ",",
            "title": "Instructions",
            "type": "quantitative"
          },
          {
            "field": "short_joined_pct",
            "format": ".2r",
            "title": "Short, joined, %",
            "type": "quantitative"
          },
          {
            "field": "short_on_its_own_pct",
            "format": ".2r",
            "title": "Short on its own, %",
            "type": "quantitative"
          }
        ],
        "x": {
          "field": "short_on_its_own_pct",
          "type": "quantitative"
        },
        "y": {
          "axis": {
            "labelExpr": "split(datum.label, '|')"
          },
          "field": "fuel_group_name",
          "scale": {
            "paddingInner": 0.3
          },
          "sort": null,
          "title": null,
          "type": "nominal"
        }
      },
      "mark": {
        "filled": false,
        "opacity": 1,
        "size": 70,
        "strokeWidth": 2,
        "type": "point"
      },
      "transform": [
        {
          "as": "key",
          "calculate": "\"Each instruction on its own\""
        }
      ]
    },
    {
      "encoding": {
        "fill": {
          "field": "key",
          "legend": {
