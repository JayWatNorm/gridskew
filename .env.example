# --- dbt: the repository profile's default target, dev, is the local
# disposable database (localhost, gridskew_dev, both fixed in the profile).
# The prod target needs --target prod or DBT_TARGET=prod, and DBT_HOST,
# DBT_PORT (5435), DBT_USER and DBT_PASSWORD set to the production server and
# the restricted dbt role, which reads raw and writes dbt_dev only.
DBT_PROFILES_DIR=
DBT_PORT=5432
DBT_USER=postgres
DBT_PASSWORD=
DBT_SCHEMA=dbt_dev
