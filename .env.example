# --- pollers: DEV database (postgres-dev, port 5434) ---
DB_HOST=
DB_PORT=5434
DB_NAME=gridskew_dev
DB_USER=
DB_PASSWORD=

# --- dbt: PROD database (postgres-prod, port 5435) ---
# Reads raw, writes dbt_dev. Separate role with no write access to raw,
# so a dbt misconfiguration cannot touch ingested data.
DBT_PROFILES_DIR=
DBT_HOST=
DBT_PORT=5435
DBT_USER=
DBT_PASSWORD=